<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Travel - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>Travel</h1>
							{{#if message}}
								<p>{{message}}</p>
							{{/if}}	

                            <ul id="sites">
                                {{#each trips}}
                                <li>
                                    <a href="/api/trips/{{code}}">
                                        <img src="/images/{{image}}" alt="{{name}}">
                                    </a>
                                    <h2>
                                        <a href="/api/trips/{{code}}">{{name}}</a>
                                    </h2>
                                    {{{description}}}
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{> footer }}
    </div>
</body>
</html>